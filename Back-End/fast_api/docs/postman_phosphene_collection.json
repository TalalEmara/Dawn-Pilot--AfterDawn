{
  "info": {
    "name": "Phosphene Vision API",
    "description": "FastAPI service for object detection and phosphene translation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "sampleImage",
      "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
      "type": "string",
      "description": "Sample 1x1 pixel image for testing"
    }
  ],
  "item": [
    {
      "name": "Service Status",
      "item": [
        {
          "name": "Root Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Get service information"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check service health and detector status"
          }
        }
      ]
    },
    {
      "name": "Object Detection",
      "item": [
        {
          "name": "Detect Objects - Base64",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"{{sampleImage}}\",\n  \"conf_threshold\": 0.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/detect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "detect"]
            },
            "description": "Detect objects in a base64-encoded image"
          }
        },
        {
          "name": "Upload Image File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select an image file to upload"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload-image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload-image"]
            },
            "description": "Upload an image file for detection and translation"
          }
        }
      ]
    },
    {
      "name": "Phosphene Translation",
      "item": [
        {
          "name": "Translate Objects - Default",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objects\": [\n    {\n      \"class\": \"person\",\n      \"confidence\": 0.92,\n      \"bbox\": [100, 150, 80, 200],\n      \"centroid_px\": [140, 250],\n      \"distance_m\": 3.5\n    },\n    {\n      \"class\": \"car\",\n      \"confidence\": 0.87,\n      \"bbox\": [300, 200, 150, 100],\n      \"centroid_px\": [375, 250],\n      \"distance_m\": 8.2\n    }\n  ],\n  \"image_width\": 640,\n  \"image_height\": 480,\n  \"t_min\": 0.3,\n  \"k_min\": 1,\n  \"k_max\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "translate"]
            },
            "description": "Translate detected objects to phosphene representation"
          }
        },
        {
          "name": "Translate Objects - High Threshold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objects\": [\n    {\n      \"class\": \"person\",\n      \"confidence\": 0.92,\n      \"bbox\": [100, 150, 80, 200],\n      \"centroid_px\": [140, 250],\n      \"distance_m\": 3.5\n    },\n    {\n      \"class\": \"car\",\n      \"confidence\": 0.87,\n      \"bbox\": [300, 200, 150, 100],\n      \"centroid_px\": [375, 250],\n      \"distance_m\": 8.2\n    }\n  ],\n  \"image_width\": 640,\n  \"image_height\": 480,\n  \"t_min\": 0.7,\n  \"k_min\": 0,\n  \"k_max\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "translate"]
            },
            "description": "Test with higher threshold - only high-scoring objects"
          }
        }
      ]
    },
    {
