            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"{{sampleImage}}\",\n  \"conf_threshold\": 0.7,\n  \"t_min\": 0.5,\n  \"k_min\": 1,\n  \"k_max\": 3\n}"
