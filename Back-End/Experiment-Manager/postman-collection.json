        {
          "name": "Add Cube - Yellow Above",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position\": { \"x\": 0, \"y\": 3, \"z\": 0 },\n  \"rotation\": { \"x\": 30, \"y\": 30, \"z\": 30 },\n  \"color\": \"#FFFF00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/world/cube",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "cube"]
            },
            "description": "Add a yellow cube above center with complex rotation"
          },
          "response": []
        },
        {
          "name": "Add Cube - Purple Forward",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position\": { \"x\": 0, \"y\": 0, \"z\": -5 },\n  \"rotation\": { \"x\": 0, \"y\": 90, \"z\": 0 },\n  \"color\": \"#800080\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/world/cube",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "cube"]
            },
            "description": "Add a purple cube forward in Z axis"
          },
          "response": []
        },
        {
          "name": "Update Cube",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position\": { \"x\": 2, \"y\": 2, \"z\": 2 },\n  \"rotation\": { \"x\": 45, \"y\": 45, \"z\": 45 },\n  \"color\": \"#FFA500\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/world/cube/:cube_id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "cube", ":cube_id"],
              "variable": [
                {
                  "key": "cube_id",
                  "value": "cube_1",
                  "description": "Replace with actual cube ID from GET /api/world"
                }
              ]
            },
            "description": "Update an existing cube's position, rotation, and color. Replace :cube_id with actual ID."
          },
          "response": []
        },
        {
          "name": "Remove Cube",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/world/cube/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "cube", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "cube_1",
                  "description": "Replace with actual cube ID to delete"
                }
              ]
            },
            "description": "Remove a cube from the world by its ID"
          },
          "response": []
        }
      ]
    },
