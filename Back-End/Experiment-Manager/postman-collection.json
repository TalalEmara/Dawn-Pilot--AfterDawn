{
  "info": {
    "name": "Dawn Pilot - Experiment Manager API",
    "description": "API endpoints for managing 3D world cubes in Dawn Pilot experiment manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "World Operations",
      "item": [
        {
          "name": "Get Current World",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/world",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world"]
            },
            "description": "Retrieve the current state of the world including all cubes"
          },
          "response": []
        },
        {
          "name": "Save World",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/world/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "save"]
            },
            "description": "Manually save the current world state to file"
          },
          "response": []
        },
        {
          "name": "Reload World",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/world/reload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "reload"]
            },
            "description": "Reload world state from the saved file"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cube Operations",
      "item": [
        {
          "name": "Add Cube - Red Center",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position\": { \"x\": 0, \"y\": 0, \"z\": 0 },\n  \"rotation\": { \"x\": 0, \"y\": 0, \"z\": 0 },\n  \"color\": \"#FF0000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/world/cube",
              "host": ["{{baseUrl}}"],
              "path": ["api", "world", "cube"]
            },
            "description": "Add a red cube at the center of the world"
          },
          "response": []
        },
        {
          "name": "Add Cube - Blue Left",
